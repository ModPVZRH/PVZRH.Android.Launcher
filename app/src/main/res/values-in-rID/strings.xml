    <!-- About -->
    <string name="about_title">PVZRH Launcher</string>
    <string name="about_description">Loader BepInEx untuk PVZRH yang mendukung Android</string>
    <string name="about_version">Versi %1$s (Build %2$d)</string>
    <string name="about_disclaimer">⚠ PVZRH Launcher tidak didukung secara resmi oleh proyek BepInEx.</string>
    <string name="about_projects_section">Proyek yang Digunakan &amp; Dirujuk</string>
    <string name="about_project_bepinex_name">BepInEx</string>
    <string name="about_project_bepinex_desc">Framework modding Unity IL2CPP — pemuat plugin inti. BepInEx 6.0.0-pre.2 oleh tim BepInEx.</string>
    <string name="about_project_fusioncore_name">FusionCore</string>
    <string name="about_project_fusioncore_desc">Container Runtime Android Unity IL2CPP milik tim Starlight. Referensi utama untuk rantai injeksi, *hook* Pine, dan arsitektur NativeLoader.</string>
    <string name="about_project_nextbep_name">NextBep (BepInEx.Android)</string>
    <string name="about_project_nextbep_desc">Fork BepInEx kustom kami untuk Android. Mengadaptasi BepInEx 6 untuk CoreCLR tersemat (embedded) + interoperabilitas IL2CPP.</string>
    <string name="about_project_bepinexandroid_name">BepInEx.Android.Launcher</string>
    <string name="about_project_bepinexandroid_desc">Peluncur BepInEx Android umum — mendukung berbagai gim dengan manajemen paket mod.</string>
    <string name="about_project_dotnet_name">dotnet/runtime</string>
    <string name="about_project_dotnet_desc">Microsoft .NET Runtime v10.0.5. Dibangun dari kode sumber dengan *backend* kripto OpenSSL untuk memperbaiki masalah SIGSEGV BoringSSL pada Android 16.</string>
    <string name="about_project_openssl_name">OpenSSL</string>
    <string name="about_project_openssl_desc">OpenSSL 3.4.0 — menggantikan BoringSSL untuk kriptografi Android ARM64. libcrypto.so + libssl.so.</string>
    <string name="about_project_pine_name">Pine</string>
    <string name="about_project_pine_desc">Framework *hook* metode Java ART (top.canyie.pine:core:0.3.0). Digunakan untuk *hook* ClassLoader, PackageManager, dan UnityPlayer.</string>
    <string name="about_project_dobby_name">Dobby</string>
    <string name="about_project_dobby_desc">Framework *hook* natif untuk ARM64. Digunakan untuk *hook* `il2cpp_init` di `libfusion`.</string>
    <string name="about_project_cpp2il_name">Cpp2IL</string>
    <string name="about_project_cpp2il_desc">Alat rekayasa balik IL2CPP. Digunakan untuk pembuatan assembly interop.</string>
