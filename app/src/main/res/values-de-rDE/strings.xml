    <string name="about_project_bepinex_name">BepInEx</string>
    <string name="about_project_bepinex_desc">Unity IL2CPP modding Framework — der Core Plugin Loader. BepInEx 6.0.0-pre.2 vom BepInEx team.</string>
    <string name="about_project_fusioncore_name">FusionCore</string>
    <string name="about_project_fusioncore_desc">Starlight Team\'s Android Unity IL2CPP Runtime Container. Hauptreferenz für Infektionskette, Pine Hooks und Native Ladungsarchitektur.</string>
    <string name="about_project_nextbep_name">NextBep (BepInEx.Android)</string>
    <string name="about_project_nextbep_desc">Unser selbstgemachte BepInEx Fork für Android. Adapiert BepInEx 6 für eingebettete CoreCLR + IL2CPP interop.</string>
    <string name="about_project_bepinexandroid_name">BepInEx.Android.Launcher</string>
    <string name="about_project_bepinexandroid_desc">Generischer BepInEx Android launcher — unterstützt mehrere Spiele mit Modpack Verwaltung.</string>
    <string name="about_project_dotnet_name">dotnet/runtime</string>
    <string name="about_project_dotnet_desc">Microsoft .NET Runtime v10.0.5. gebaut von source mit OpenSSL crypto backend, um BoringSSL SIGSEGV zu reparieren auf Android 16.</string>
    <string name="about_project_openssl_name">OpenSSL</string>
    <string name="about_project_openssl_desc">OpenSSL 3.4.0 — ersetzt BoringSSL für ARM64 Android crypto. libcrypto.so + libssl.so.</string>
    <string name="about_project_pine_name">Pine</string>
    <string name="about_project_pine_desc">ART Java Methode hook Framework (top.canyie.pine:core:0.3.0). Wird für ClassLoader, PackageManager und UnityPlayer hooks verwendet.</string>
    <string name="about_project_dobby_name">Dobby</string>
    <string name="about_project_dobby_desc">Native hook Framework für ARM64. Wird für il2cpp_init Hook in libfusion verwendet.</string>
    <string name="about_project_cpp2il_name">Cpp2IL</string>
    <string name="about_project_cpp2il_desc">IL2CPP Reverse Engineering Tool. Wird für die Generierung von Interop assembly generierung verwendet.</string>
